# ---------------------------------------------------------------------------
# Land cover / land use classifier: settings
#
# Copy this file to `.env` and fill in the values:
#     cp example.env .env          (Linux / macOS)
#     copy example.env .env        (Windows)
# Keep .env private: it contains the database password.
# ---------------------------------------------------------------------------

# --- Database (read-only) --------------------------------------------------
# Only used by "Fetch from database" in the Data tab, which runs one SELECT on
# DB_SCHEMA.DB_TABLE. Nothing is ever written to the database.
# If data/records_snapshot.parquet is already present (e.g. copied in a packed
# zip), these can stay empty.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=public
DB_TABLE=records

# SSL: disable | prefer | require | verify-full
DB_SSLMODE=prefer
# Seconds to wait for the connection
DB_CONNECT_TIMEOUT=10


# --- Mistral API -----------------------------------------------------------
# Record titles and abstracts are sent to Mistral for classification.
# Get a key at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Optional
# MISTRAL_MODEL=mistral-small-latest
# Parallel requests
# MISTRAL_CONCURRENCY=8
# Records scored per API call (1 = one record per call: more stable labels, about 2x slower)
# MISTRAL_PACK=5
# Client-side limits per minute, used until the API reports your account limits
# MISTRAL_RPM=90
# MISTRAL_TPM=90000
# USD per million tokens, only used for the cost estimate in the UI
# MISTRAL_PRICE_INPUT=0.15
# MISTRAL_PRICE_OUTPUT=0.60
