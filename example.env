# ---------------------------------------------------------------------------
# Land cover / land use classifier: settings
#
# Copy this file to `.env` and fill in the values:
#     cp example.env .env          (Linux / macOS)
#     copy example.env .env        (Windows)
# Keep .env private: it contains the database password.
# ---------------------------------------------------------------------------

# --- Database (read-only) --------------------------------------------------
# Only used by "Fetch from database" in the Data tab, which runs one SELECT on
# DB_SCHEMA.DB_TABLE. Nothing is ever written to the database.
# If data/records_snapshot.parquet is already present (e.g. copied in a packed
# zip), these can stay empty.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=public
DB_TABLE=records

# SSL: disable | prefer | require | verify-full
DB_SSLMODE=prefer
# Seconds to wait for the connection
DB_CONNECT_TIMEOUT=10


# --- Hardware (optional) ---------------------------------------------------
# Leave commented out to auto-detect (recommended). Check what was detected with:
#     .venv/bin/python -m landclass.hardware

# Device: cuda | cuda:1 (second GPU) | mps (Apple Silicon) | cpu
# LANDCLASS_DEVICE=cuda

# Precision: fp32 | fp16 | bf16
#   bf16 → RTX 30xx/40xx/50xx, A100 and newer
#   fp16 → RTX 20xx, T4, V100
#   fp32 → GTX 16xx and older, CPU (fp16 is ~4x slower on GTX cards)
# LANDCLASS_DTYPE=bf16

# Texts per GPU batch. Auto picks from GPU memory; halved automatically when
# the GPU runs out of memory.
# LANDCLASS_BATCH=32


# --- Model (optional) ------------------------------------------------------
# Hugging Face id or local folder. Default: models/GLiNER2.5-Decide if it
# exists (downloaded by setup), otherwise fastino/GLiNER2.5-Decide.
# LANDCLASS_MODEL=fastino/GLiNER2.5-Decide
